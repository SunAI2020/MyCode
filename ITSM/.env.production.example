# 生产环境变量（复制为 .env.production 后按需修改；docker-compose.prod.yml 经 env_file 读取）
# 说明：postgres/redis/elasticsearch 的服务地址由 compose 的 environment 强制覆盖为容器网络，
#       无需在此配置；此处仅需配置应用自身项。

# SECRET_KEY 必填，生产用强随机值固定（留空则每次重启变化，JWT 全部失效）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 前端经 nginx 同源反代 /api，一般无需 CORS；直连 API 时按需放开
CORS_ORIGINS=http://localhost:8080

# 定期工单/SLA 预警调度器（生产单实例开启）
ENABLE_SCHEDULER=true

# 生产置于 nginx 反代之后，置 true 使审计记录真实客户端 IP（读 X-Real-IP）
TRUST_PROXY_HEADERS=true

# 管理员初始密码（seed 时生效）；未设置时 seed 生成强随机口令并打印，登录后请立即修改
# ADMIN_INITIAL_PASSWORD=

# 可配置大模型（OpenAI 兼容 API；留空 = RAG 降级为纯检索）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
