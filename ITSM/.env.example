# 复制为 .env 后按需修改
# DATABASE_URL 必填；若在 docker-compose 用 POSTGRES_PASSWORD 改了密码，需同步此处的密码
DATABASE_URL=postgresql+psycopg://itsm:itsm_password@localhost:5433/itsm
# 管理员初始密码（seed 时生效），默认 admin123
# ADMIN_INITIAL_PASSWORD=admin123
# SECRET_KEY 留空时后端用随机密钥（每次重启变化）；生产请固定为强随机值：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# 可选中间件（留空 = 禁用，后端自动降级到内存缓存 / SQL 检索）
# REDIS_URL=redis://localhost:6379/0
# ELASTICSEARCH_URL=http://localhost:9200
