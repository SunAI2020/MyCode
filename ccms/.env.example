# CCMS 环境配置
# 复制此文件为 .env 并填入实际值

# 数据库
DATABASE_URL=postgresql+asyncpg://ccms:ccms_secret_2026@localhost:5432/ccms
DATABASE_URL_SYNC=postgresql://ccms:ccms_secret_2026@localhost:5432/ccms

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# 微信小程序
WECHAT_MINI_APP_ID=wx_your_mini_app_id
WECHAT_MINI_APP_SECRET=your_mini_app_secret

# 微信公众号
WECHAT_MP_APP_ID=wx_your_mp_app_id
WECHAT_MP_APP_SECRET=your_mp_app_secret
WECHAT_MP_TOKEN=your_mp_token
WECHAT_MP_ENCODING_AES_KEY=your_43_char_encoding_aes_key

# 服务配置
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true
